# ---------------------------------------------------------------------------
# Copy to .env.local (or .env.development / .env.production) and fill in.
# Every variable below is declared in src/config/env.validation.ts
# ---------------------------------------------------------------------------

# --- REQUIRED: server refuses to boot without these ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dr_consultation

# --- OPTIONAL: defaults shown; may be omitted entirely ---
NODE_ENV=local
PORT=3000

DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=1000

# Comma-free single origin, or omit to allow all.
# CORS_ORIGIN=http://localhost:5173
