# ---------------------------------------------------------------------------
# Copy to .env.local (or .env.development / .env.production) and fill in.
# Every variable below is declared in src/config/env/env.validation.ts
# ---------------------------------------------------------------------------

# --- REQUIRED: server refuses to boot without these ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dr_consultation

# Auth. Generate with e.g. `openssl rand -hex 32`. Must NOT be equal to each other.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Slide (slide.synquic.in) — the OTP vendor. API key from Dashboard -> API Keys,
# needs the otp:send and otp:verify scopes. Widget id from Dashboard -> OTP.
SLIDE_API_KEY=
SLIDE_OTP_WIDGET_ID=

# Master key for AES-256-GCM encryption of the LLM provider API keys an admin
# enters in the panel (agent_credentials.encrypted_key). Must be EXACTLY 64
# hexadecimal characters — that is the 32 bytes AES-256 requires.
#
#   openssl rand -hex 32
#
# Never commit a real one, never reuse the JWT secrets, and use a different
# key per environment. Changing it does NOT re-encrypt existing rows: every
# stored credential becomes undecryptable and has to be re-entered in the
# admin panel.
AI_CREDENTIAL_ENCRYPTION_KEY=

# Razorpay (modules/payment, M-12). All three are REQUIRED, unlike the optional
# S3/Cloudinary keys below: Razorpay is the SOLE payment gateway this release
# integrates (payments.schema.ts — "no gateway column"), so there is no fallback
# and a deployment missing a key cannot take a single payment. Failing at boot
# with the variable named beats failing at the first checkout.
#
# Key id and secret: Dashboard -> Account & Settings -> API Keys. The key id is
# the PUBLISHABLE half and is sent to the mobile app for Checkout; the secret
# never leaves the server.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# A SEPARATE secret, set when you register the webhook under Dashboard ->
# Settings -> Webhooks. It is NOT the API key secret. The webhook route is
# public, so this HMAC is the only thing standing between it and an attacker
# marking any consultation paid — treat it like a password.
#
# Register the endpoint as:  https://<host>/api/payments/webhook
#   (note the /api global prefix)
# Subscribe at least to: payment.captured, payment.failed, refund.processed,
# refund.failed
RAZORPAY_WEBHOOK_SECRET=

# --- OPTIONAL: defaults shown; may be omitted entirely ---
NODE_ENV=local
PORT=3000

DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_DELAY_MS=1000

# Event Emitter tuning
EVENTS_MAX_LISTENERS=20
EVENTS_WILDCARD=true
EVENTS_DELIMITER=.
EVENTS_VERBOSE_MEMORY_LEAK=false

# Transactional Outbox Worker tuning
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
OUTBOX_RETRY_BACKOFF_MS=1000

# Comma-free single origin, or omit to allow all.
# CORS_ORIGIN=http://localhost:5173

# Set true only when running behind a load balancer / reverse proxy that
# sets X-Forwarded-For, so request.ip is the real client IP. Left false, the
# per-IP OTP rate limit would otherwise collapse onto the proxy's own IP.
TRUST_PROXY=false

# Auth / JWT tuning
JWT_ISSUER=dr-consultation
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ADMIN_REFRESH_TTL=12h

# Omit to use the Slide SDK's own default base URL.
# SLIDE_BASE_URL=https://slide.synquic.com/api/v1

# --- SEED SCRIPT ONLY (npm run db:seed) — not read by the running server ---
# When set, seeds one bootstrap super_admin linked to the super_admin role.
# When absent, the seed still writes roles/permissions/app_config and skips
# admin creation entirely.
# BOOTSTRAP_SUPER_ADMIN_MOBILE=+919876543210
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Owner

# modules/storage — blob storage (S3 primary, Cloudinary automatic secondary).
# Both pairs are OPTIONAL: a deployment may legitimately run with only one
# provider configured (the other is simply unusable until its keys are set,
# same as if it started failing every call — never a boot failure). Non-secret
# settings (bucket, region, optional custom S3-compatible endpoint, Cloudinary
# cloud name) are admin-editable via PATCH /admin/storage/providers/:id, not
# env — only the actual secret keypairs live here, per SRS 6.1.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
